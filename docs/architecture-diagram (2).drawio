        </mxCell>
        <mxCell id="redis" value="redis&lt;br&gt;Redis 7 :6379" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="310" width="140" height="70" as="geometry" />
