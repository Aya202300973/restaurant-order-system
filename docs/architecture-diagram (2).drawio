        </mxCell>
        <mxCell id="backend" value="backend&lt;br&gt;FastAPI :5000" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="db&lt;br&gt;MySQL 8.4 :3306" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;html=1;" vertex="1" parent="1">
