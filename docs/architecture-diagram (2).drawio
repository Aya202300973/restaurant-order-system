<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="arch2">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="net1" value="backend-network" style="rounded=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="470" height="300" as="geometry" />
        </mxCell>
        <mxCell id="net2" value="database-network (internal)" style="rounded=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;verticalAlign=top;align=right;spacingRight=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1">
