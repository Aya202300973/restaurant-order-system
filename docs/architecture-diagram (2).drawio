        <mxCell id="note" value="Published ports: frontend (FRONTEND_PORT) for everyone, adminer on 127.0.0.1 only. Backend (5000), Redis (6379) and MySQL (3306) are not exposed to the host." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1">
