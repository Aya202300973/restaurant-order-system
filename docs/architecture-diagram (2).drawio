        <mxCell id="adminer" value="adminer :8080&lt;br&gt;host 127.0.0.1:8081" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="310" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vol" value="volume: mysql-data" style="shape=cylinder3;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
